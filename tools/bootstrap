#!/usr/bin/env bash
# Applies an environment's bootstrap stage from a workstation, once, then
# moves its state into the bucket it created.
#
#   tools/bootstrap pokechamps/prod
#
# A bootstrap stage (<project>/<environment>/bootstrap/) creates the
# environment's project, Terraform's service account, the state bucket and
# the GitHub Actions identity link -- what CI needs before it can apply
# anything -- so a person applies it, as themselves:
#
#   gcloud auth application-default login      (the account that owns the billing account)
#   export TF_VAR_billing_account_id=XXXXXX-XXXXXX-XXXXXX
#   export TF_VAR_github_owner_id=<the GitHub organisation's numeric id>
#
# Steps: `terraform apply` with local state (Terraform shows the plan and
# asks before creating anything); then, the first time, backend.tf is
# written to point at the new bucket and the state is copied into it and
# removed from this machine. Running it again later applies changes to
# the stage against the state in the bucket. backend.tf holds only the
# bucket's name and is committed.
set -euo pipefail

environment=${1:?usage: tools/bootstrap <project>/<environment>}
stage="$(cd "$(dirname "$0")/.." && pwd)/$environment/bootstrap"
[ -d "$stage" ] || { echo "no bootstrap stage at $stage" >&2; exit 1; }
: "${TF_VAR_billing_account_id:?set TF_VAR_billing_account_id (see this script's header)}"
: "${TF_VAR_github_owner_id:?set TF_VAR_github_owner_id (see this script's header)}"

cd "$stage"
terraform init -input=false
terraform apply

if [ ! -f backend.tf ]; then
  bucket=$(terraform output -raw state_bucket)
  cat > backend.tf <<BACKEND
terraform {
  backend "gcs" {
    bucket = "$bucket"
    prefix = "bootstrap"
  }
}
BACKEND
  terraform init -input=false -migrate-state -force-copy
  # The state now lives in the bucket; a copy left here would go stale.
  rm -f terraform.tfstate terraform.tfstate.backup
  echo
  echo "State moved to gs://$bucket/bootstrap. Commit $environment/bootstrap/backend.tf."
fi

# The variables are named after the environment (pokechamps/prod ->
# PROD_...), since each has a project and accounts of its own.
prefix=$(basename "$environment" | tr '[:lower:]-' '[:upper:]_')
echo
echo "Set these as Actions variables of the infra repository:"
echo "  ${prefix}_GCP_PROJECT_ID=$(terraform output -raw project_id)"
echo "  ${prefix}_GCP_SERVICE_ACCOUNT=$(terraform output -raw terraform_service_account)"
echo "  ${prefix}_GCP_PLAN_SERVICE_ACCOUNT=$(terraform output -raw plan_service_account)"
echo "  ${prefix}_GCP_WORKLOAD_IDENTITY_PROVIDER=$(terraform output -raw workload_identity_provider)"
echo "  ${prefix}_TF_STATE_BUCKET=$(terraform output -raw state_bucket)"
