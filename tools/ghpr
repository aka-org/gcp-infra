#!/usr/bin/env python3
"""Pushes a branch and opens its pull request, for work a person reviews.

    ghpr open  REPO_DIR --title TITLE [--body-file FILE] [--draft]
    ghpr checks REPO_DIR
    ghpr token REPO_DIR          (prints nothing secret: only whether a token can be minted)

`open` pushes REPO_DIR's current branch to origin over SSH and opens a pull
request against the repository's default branch, or reports the one already
open. It refuses to push the default branch, never force-pushes, never
merges and never tags: merging stays with the reviewer. `checks` lists the
check runs of the branch's newest commit.

The push uses an SSH key (GHPR_SSH_KEY, default ~/.ssh/homelab). The pull
request is opened by a GitHub App, so its author is the App and the
repository's owner can review and approve it. The App's settings are read
from ~/.config/aka-org/github-app.env (or the file named by GHPR_CONFIG),
KEY=VALUE lines:

    APP_ID=123456                    the App's id (its settings page)
    PRIVATE_KEY=/path/to/app.pem     a private key generated for the App

The App needs these repository permissions on each repository it is
installed on: Pull requests read and write, Checks read, Metadata read.
Nothing here stores a token: an installation token is minted per call
(valid one hour) and kept in memory only.

Needs git, ssh and openssl; Python's standard library otherwise.
"""
import argparse
import base64
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

API = "https://api.github.com"


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], check=True, capture_output=True, text=True).stdout.strip()


def slug(repo):
    """owner/name from origin's URL (SSH or HTTPS form)."""
    url = git(repo, "remote", "get-url", "origin")
    match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
    if not match:
        sys.exit(f"origin is not a GitHub repository: {url}")
    return match.group(1)


def config():
    path = os.environ.get("GHPR_CONFIG", os.path.expanduser("~/.config/aka-org/github-app.env"))
    if not os.path.exists(path):
        sys.exit(f"no GitHub App settings at {path} (see this script's docstring)")
    values = {}
    for line in open(path):
        line = line.strip()
        if line and not line.startswith("#"):
            key, _, value = line.partition("=")
            values[key.strip()] = os.path.expanduser(value.strip())
    for key in ("APP_ID", "PRIVATE_KEY"):
        if not values.get(key):
            sys.exit(f"{path} lacks {key}")
    return values


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=")


def app_jwt(settings):
    """A JSON Web Token signed with the App's key: GitHub accepts it for ten
    minutes at most, and only to mint installation tokens."""
    now = int(time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    claims = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": settings["APP_ID"]}).encode())
    signing_input = header + b"." + claims
    signature = subprocess.run(["openssl", "dgst", "-sha256", "-sign", settings["PRIVATE_KEY"]],
                               input=signing_input, check=True, capture_output=True).stdout
    return (signing_input + b"." + b64url(signature)).decode()


def call(method, path, token, body=None):
    request = urllib.request.Request(API + path, method=method,
                                     data=json.dumps(body).encode() if body is not None else None)
    request.add_header("Authorization", f"Bearer {token}")
    request.add_header("Accept", "application/vnd.github+json")
    request.add_header("X-GitHub-Api-Version", "2022-11-28")
    request.add_header("User-Agent", "ghpr")
    try:
        with urllib.request.urlopen(request) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        sys.exit(f"{method} {path}: {error.code} {error.read().decode()[:300]}")


def installation_token(repo_slug):
    jwt = app_jwt(config())
    installation = call("GET", f"/repos/{repo_slug}/installation", jwt)
    return call("POST", f"/app/installations/{installation['id']}/access_tokens", jwt)["token"]


def branches(repo, repo_slug, token):
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    default = call("GET", f"/repos/{repo_slug}", token)["default_branch"]
    if branch in (default, "HEAD"):
        sys.exit(f"on {branch}: pull requests are opened from a work branch")
    return branch, default


def open_pr(args):
    repo_slug = slug(args.repo)
    token = installation_token(repo_slug)
    branch, default = branches(args.repo, repo_slug, token)
    if git(args.repo, "status", "--porcelain", "--untracked-files=no"):
        sys.exit("uncommitted changes to tracked files: commit them first")
    key = os.path.expanduser(os.environ.get("GHPR_SSH_KEY", "~/.ssh/homelab"))
    subprocess.run(["git", "-C", args.repo, "push", "-u", "origin", branch], check=True,
                   env={**os.environ, "GIT_SSH_COMMAND": f"ssh -i {key} -o IdentitiesOnly=yes"})
    owner = repo_slug.split("/")[0]
    existing = call("GET", f"/repos/{repo_slug}/pulls?head={owner}:{branch}&state=open", token)
    if existing:
        print(f"already open: {existing[0]['html_url']}")
        return
    body = open(args.body_file).read() if args.body_file else ""
    pr = call("POST", f"/repos/{repo_slug}/pulls", token,
              {"title": args.title, "head": branch, "base": default, "body": body, "draft": args.draft})
    print(pr["html_url"])


def checks(args):
    repo_slug = slug(args.repo)
    token = installation_token(repo_slug)
    sha = git(args.repo, "rev-parse", "HEAD")
    runs = call("GET", f"/repos/{repo_slug}/commits/{sha}/check-runs", token)["check_runs"]
    for run in runs:
        print(f"{run['name']:40} {run['status']:12} {run['conclusion'] or ''}")
    if not runs:
        print(f"no check runs for {sha[:7]}")


def token_check(args):
    installation_token(slug(args.repo))
    print("an installation token can be minted for", slug(args.repo))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    p = commands.add_parser("open"); p.add_argument("repo"); p.add_argument("--title", required=True)
    p.add_argument("--body-file"); p.add_argument("--draft", action="store_true"); p.set_defaults(run=open_pr)
    p = commands.add_parser("checks"); p.add_argument("repo"); p.set_defaults(run=checks)
    p = commands.add_parser("token"); p.add_argument("repo"); p.set_defaults(run=token_check)
    args = parser.parse_args()
    args.run(args)


if __name__ == "__main__":
    main()
